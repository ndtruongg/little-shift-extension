{
  "manifest_version": 3,
  "name": "Little Shift — Góc tập trung",
  "version": "1.0.0",
  "description": "Một góc làm việc pixel ấm áp. Quản lý công việc, tập trung và nghỉ ngơi đúng nhịp.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Little Shift",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
